{
  "name": "iot",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js --watch src --watch public",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "npm run test -- --watch",
    "test:coverage": "npm run test -- --coverage",
    "lint": "echo 'Linting not configured yet'",
    "db:setup": "psql -h localhost -U postgres -d iot_parking -f scripts/database/schema.sql",
    "db:seed": "psql -h localhost -U postgres -d iot_parking -f scripts/database/seed.sql",
    "db:reset": "psql -h localhost -U postgres -d iot_parking -c \"DROP SCHEMA public CASCADE; CREATE SCHEMA public;\" && npm run db:setup && npm run db:seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "chartjs-adapter-date-fns": "^3.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "morgan": "^1.10.1",
    "nodemon": "^3.1.10",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  }
}
